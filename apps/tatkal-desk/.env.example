# Copy to `.env.local` — never commit real values.
# Prefer attended login: leave IRCTC_PASSWORD empty and type it in the browser.

# Optional username hint for local Playwright scaffolding
IRCTC_USERNAME=

# Optional — better left empty; type password only during HAND TO ME takeover
# IRCTC_PASSWORD=

# simulate (default timeline practice) | playwright (same timeline; use Open IRCTC for the headed window)
BOOKING_MODE=simulate

# Optional future local vault passphrase
# CREDENTIALS_SECRET=
